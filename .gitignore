temp/
output/
scratch/
scratch_test_download/
projects/*.json
projects/*.avr.json
logs/
*.log
*.tmp
*.mp4
*.mp3
*.zip
!src_app/assets/overlays/*.mp4
!assets/overlays/*.mp4

# src_app data & tools
src_app/data/temp/
src_app/data/output/
src_app/data/logs/
src_app/data/tokens/
src_app/data/projects/*.json
src_app/data/projects/*.avr.json
